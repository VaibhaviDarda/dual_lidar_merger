<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dual_lidar_merger</name>
  <version>1.0.0</version>
  <description>
    Merges two YDLidar X2 LaserScan topics into one unified /scan_merged topic.
    Both LiDARs must be mounted on the same horizontal plane.
    Supports configurable overlap handling, angle masking and a robot-body (footprint) filter.
  </description>
  <maintainer email="vaibhavi.darda@gmail.com">Vaibhavi Darda</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Only needed for dual_lidar_full.launch.py / view_merged.launch.py -->
  <exec_depend>ydlidar_ros2_driver</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
